# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The map artwork and the character sheets are the product, not build output:
# without them the site renders an empty canvas. They are committed.
# The first render, superseded by map2.png and kept only locally.
/public/map/IsoMAP.jpg

# The CV PDF carries a phone number and this repository is public. It stays on
# disk and is uploaded to the host separately; see public/README.md.
/public/*.pdf

# Kept from the repository's own .gitignore, which this history had not seen.
.env
.env*.local
.pnp.js
